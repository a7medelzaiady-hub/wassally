<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة البداية: بنفسجي وصّلي + اللوجو (بدل لون الثيم الأبيض).
     بتظهر لحد أول فريم من Flutter، وبعدها BrandSplash بنفس اللون، فمفيش وميض أبيض. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/wasally_splash" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
