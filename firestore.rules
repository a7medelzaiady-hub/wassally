
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // المدير = ليه مستند في admins/{uid} (بتضيفه يدويًا من Firebase Console).
    // أو claim اسمه admin بيتحط من السيرفر فقط (Cloud Function: setUserRole).
    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // المندوب = ليه مستند في couriers/{uid} وحقل active مش false.
    function isCourier() {
      return signedIn() &&
        exists(/databases/$(database)/documents/couriers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/couriers/$(request.auth.uid))
          .data.get('active', true) == true;
    }

    // المشرف = ليه مستند في supervisors/{uid} وحقل active مش false. بيدير مناديب مربوطين بيه.
    function isSupervisor() {
      return signedIn() &&
        exists(/databases/$(database)/documents/supervisors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/supervisors/$(request.auth.uid))
          .data.get('active', true) == true;
    }

    // صاحب المحل = ليه مستند في storeOwners/{uid} فيه storeId وحقل active مش false.
    // المدير هو اللي بيضيفه (من التطبيق)، وصاحب المحل ما يقدرش يكتب في المستند ده.
    function isStoreOwner(storeId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/storeOwners/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/storeOwners/$(request.auth.uid))
          .data.get('active', true) == true &&
        get(/databases/$(database)/documents/storeOwners/$(request.auth.uid))
          .data.get('storeId', '') == storeId;
    }

    // صاحب طلب الانضمام يدير مسودته فقط أثناء المراجعة أو بعد الرفض لإعادة التقديم.
    function isStoreApplicant(storeId) {
      let storePath = /databases/$(database)/documents/stores/$(storeId);
      let requestPath = /databases/$(database)/documents/role_requests/$(request.auth.uid + '_store_owner');
      return signedIn() &&
        exists(storePath) &&
        get(storePath).data.get('ownerUid', '') == request.auth.uid &&
        exists(requestPath) &&
        get(requestPath).data.get('storeId', '') == storeId &&
        get(requestPath).data.get('status', '') in ['pending', 'rejected'];
    }

    // حالة active هي بوابة النشر العامة؛ المسودات تبدأ false.
    function isPublicStore(storeId) {
      let path = /databases/$(database)/documents/stores/$(storeId);
      return exists(path) && get(path).data.get('active', true) == true;
    }

    // أي صاحب محل نشط (للكتالوج المشترك app_info/catalog).
    function isAnyStoreOwner() {
      return signedIn() &&
        exists(/databases/$(database)/documents/storeOwners/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/storeOwners/$(request.auth.uid))
          .data.get('active', true) == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validStatus(s) {
      return s in ['new', 'preparing', 'on_the_way', 'delivered', 'cancelled'];
    }

    // إعداد أمني اختياري واحد ما زال تدريجيًا: orderRateLimit.
    // باقي ضوابط دورة الطلب (التجهيز والجاهزية والختم المالي وانتقالات الإدارة)
    // أصبحت إلزامية في القواعد ولا تعتمد على flags قابلة للترك دون تفعيل.
    // orderRateLimit: true يفرض فاصل 20 ثانية بين طلبين من نفس العميل.
    function securityFlag(name) {
      return exists(/databases/$(database)/documents/app_info/security) &&
        get(/databases/$(database)/documents/app_info/security).data.get(name, false) == true;
    }


    // ───────────── ختم التسليم (إحصائيات المناديب والمدير) ─────────────
    // عند التسليم بيتسجّل: مين سلّم (deliveredBy)، إمتى (deliveredAt = وقت السيرفر)،
    // المبلغ المحصّل (collectedAmount = الإجمالي المعتمد أو الأصلي)، وعمولة المندوب
    // (courierEarning = رسوم التوصيل في الطلب). القواعد بتتحقق إن الأرقام دي مطابقة للطلب،
    // فالمندوب ما يقدرش يكتب أرقام من عنده.
    function stampKeys() {
      return ['deliveredBy', 'deliveredAt', 'collectedAmount', 'courierEarning'];
    }

    // k = diff().affectedKeys() محسوب مرة واحدة في evalOrderUpdate ومتبعوت هنا (من غير ما نعيد حساب الـ diff).
    function deliveryStampOk(courierUid, k) {
      return !k.hasAny(stampKeys()) || (
        k.hasAll(stampKeys()) &&
        request.resource.data.get('status', '') == 'delivered' &&
        courierUid is string && courierUid.size() > 0 &&
        request.resource.data.get('deliveredBy', '') == courierUid &&
        request.resource.data.get('deliveredAt', null) == request.time &&
        request.resource.data.get('courierEarning', -1) is number &&
        request.resource.data.get('courierEarning', -1) ==
          request.resource.data.get('finalDeliveryFee', request.resource.data.get('deliveryFee', -2)) &&
        request.resource.data.get('collectedAmount', -1) is number &&
        request.resource.data.get('collectedAmount', -1) ==
          request.resource.data.get('verifiedTotal', request.resource.data.get('total', -2)));
    }

    // رسوم التوصيل النهائية: الأدمن بس بيحددها (لما يوافق على الطلب)، ولو ما حددهاش بتفضل الافتراضية.
    function validFinalFee(k) {
      return !('finalDeliveryFee' in k) || (
        request.resource.data.get('finalDeliveryFee', -1) is number &&
        request.resource.data.finalDeliveryFee >= 0 &&
        request.resource.data.finalDeliveryFee <= 500);
    }

    // أي تسليم من المندوب أو الإدارة لازم يجي مع الختم المالي الكامل.
    function stampRequired(k) {
      // ختم التسليم المالي إلزامي دائمًا؛ لا نعتمد على flag يمكن أن يكون غير مفعّل.
      return request.resource.data.get('status', '') != 'delivered' ||
        k.hasAll(stampKeys());
    }

    // انتقالات الإدارة متسلسلة: لا تخطي للتجهيز/الجاهزية ولا إعادة فتح حالة نهائية.
    function adminMoveOk(k) {
      return !('status' in k) ||
        (resource.data.get('status', '') == 'new' &&
          request.resource.data.get('status', '') in ['preparing', 'cancelled']) ||
        (resource.data.get('status', '') == 'preparing' &&
          (request.resource.data.get('status', '') == 'cancelled' ||
           (request.resource.data.get('status', '') == 'on_the_way' &&
            resource.data.get('ready', false) == true &&
            request.resource.data.get('pickedUpAt', null) == request.time &&
            resource.data.get('courierId', '') is string &&
            resource.data.get('courierId', '').size() > 0))) ||
        (resource.data.get('status', '') == 'on_the_way' &&
          request.resource.data.get('status', '') == 'delivered' &&
          (resource.data.get('pickedUpAt', null) is timestamp ||
           resource.data.get('courierAt', null) is timestamp) &&
          resource.data.get('courierArrivedAt', null) is timestamp &&
          k.hasAll(stampKeys()));
    }

    // تغيير الحالة لازم يجي مع حدث في statusHistory (نفس الـ batch) دائمًا.
    function historyGate(orderId, k) {
      // سجل الحالة إلزامي دائمًا عند تغيير status، وليس مرتبطًا بمفتاح تشغيل اختياري.
      return !('status' in k) ||
        existsAfter(/databases/$(database)/documents/orders/$(orderId)/statusHistory/$(request.resource.data.get('status', '')));
    }

    function validCourierForAssignment(courierId) {
      return courierId is string && courierId.size() > 0 &&
        exists(/databases/$(database)/documents/couriers/$(courierId)) &&
        get(/databases/$(database)/documents/couriers/$(courierId)).data.get('active', true) == true;
    }

    // ───────────── التحقق من بيانات الطلب الجديد ─────────────
    // الحد الأقصى لأصناف الطلب (100) لازم يطابق kMaxOrderLines في lib/services/order_service.dart.
    // مهم: القواعد بتتأكد إن الأرقام متسقة مع بعض (الإجمالي = مجموع الأسطر + التوصيل)
    // لكنها مابتقارنش بأسعار الكتالوج. المقارنة دي بيعملها المدير عند الاعتماد
    // (verifiedTotal)، والمندوب بيحصّل المبلغ المعتمد.

    function orderKeys() {
      // الخصوصية: مستند الطلب العام (اللي بيقراه صاحب المحل والمناديب) مفيهوش موبايل ولا عنوان
      // ولا إيميل ولا الاسم الكامل. دول في orders/{id}/private/contact (انظر تحت).
      return ['userId', 'customerName', 'notes',
              'storeId', 'storeName', 'items', 'subtotal', 'deliveryFee',
              'total', 'paymentMethod', 'status', 'createdAt'];
    }

    // الخصم: صفر، أو كود نشط في promos/{code} والخصم ما يتعداش نسبته من المجموع.
    function promoOk(d) {
      return d.get('discount', 0) == 0 || (
        d.get('promoCode', '') is string && d.get('promoCode', '').size() > 0 &&
        d.discount is number && d.discount > 0 &&
        d.subtotal is number && d.discount < d.subtotal &&
        exists(/databases/$(database)/documents/promos/$(d.promoCode)) &&
        get(/databases/$(database)/documents/promos/$(d.promoCode)).data.get('active', false) == true &&
        get(/databases/$(database)/documents/promos/$(d.promoCode)).data.get('percent', 0) is number &&
        // ضرب في 0.01 بدل القسمة على 100 عشان نتجنب أي مشكلة في قسمة الأعداد الصحيحة.
        d.discount <= d.subtotal * get(/databases/$(database)/documents/promos/$(d.promoCode)).data.get('percent', 0) * 0.01 + 0.01);
    }

    // المحل لازم يكون موجود ونشط (أي نوع محل: مطعم، بقالة، ورد، صيدلية...).
    function eligibleStoreForOrder(d) {
      return d.storeId is string && d.storeId.size() > 0 &&
        exists(/databases/$(database)/documents/stores/$(d.storeId)) &&
        get(/databases/$(database)/documents/stores/$(d.storeId)).data.get('active', true) == true;
    }

    // فاصل بين طلبين من نفس العميل (يتفعّل بمفتاح orderRateLimit). التطبيق بيكتب orderLimits/{uid}.lastAt
    // في نفس الـ batch مع الطلب، والقاعدة بتتأكد إن آخر طلب أقدم من 20 ثانية.
    function orderRateOk(uid) {
      return !securityFlag('orderRateLimit') || (
        existsAfter(/databases/$(database)/documents/orderLimits/$(uid)) &&
        getAfter(/databases/$(database)/documents/orderLimits/$(uid)).data.get('lastAt', null) == request.time &&
        (!exists(/databases/$(database)/documents/orderLimits/$(uid)) ||
          get(/databases/$(database)/documents/orderLimits/$(uid)).data.lastAt <=
            request.time - duration.value(20, 's')));
    }

    // ───────────── إنشاء الطلب (نسخة مبسّطة) ─────────────
    // زي تطبيقات التوصيل الصغيرة: العميل بيحسب الأسعار، والقواعد بتتأكد من الشكل والحدود بس.
    // مراجعة السعر الحقيقي بتتم عند الأدمن (verifiedTotal) والمندوب بيحصّل المبلغ المعتمد.
    // مفيش حد صغير للأصناف: الحد الأقصى 100 صنف، ومفيش قراءات لكل صنف.
    function customerNotRestricted(uid) {
      let p = /databases/$(database)/documents/customer_restrictions/$(uid);
      let restriction = get(p).data;
      return restriction == null ||
        restriction.get('active', false) != true ||
        restriction.get('expiresAt', request.time) <= request.time;
    }

    function validNewOrder(d) {
      return d.keys().hasOnly(orderKeys().concat(['area', 'promoCode', 'discount', 'freeDelivery'])) &&
        d.keys().hasAll(orderKeys()) &&
        (!('freeDelivery' in d) || (d.freeDelivery == true && d.deliveryFee == 0)) &&
        d.get('area', '') is string && d.get('area', '').size() <= 60 &&
        promoOk(d) &&
        customerNotRestricted(request.auth.uid) &&
        d.userId == request.auth.uid &&
        d.status == 'new' &&
        d.paymentMethod == 'cash' &&
        d.createdAt == request.time &&
        d.customerName is string && d.customerName.size() >= 1 && d.customerName.size() <= 30 &&
        d.notes is string && d.notes.size() <= 500 &&
        d.storeId is string && d.storeId.size() <= 100 &&
        d.storeName is string && d.storeName.size() >= 1 && d.storeName.size() <= 100 &&
        eligibleStoreForOrder(d) &&
        d.items is list && d.items.size() >= 1 && d.items.size() <= 100 &&
        d.subtotal is number && d.subtotal >= 0 && d.subtotal <= 100000 &&
        d.deliveryFee is number && d.deliveryFee >= 0 && d.deliveryFee <= 500 &&
        d.total is number && d.total > 0 && d.total <= 100000 &&
        math.abs(d.total - (d.subtotal + d.deliveryFee - d.get('discount', 0))) < 0.01;
    }

    // بيانات التواصل في orders/{id}/private/contact.
    function validContact(d) {
      return d.keys().hasOnly(['userName', 'phone', 'address', 'courierNotes']) &&
        d.keys().hasAll(['userName', 'phone', 'address']) &&
        (!('courierNotes' in d) ||
          (d.courierNotes is string && d.courierNotes.size() <= 300)) &&
        d.userName is string && d.userName.size() >= 1 && d.userName.size() <= 80 &&
        d.phone is string && d.phone.matches('^01[0125][0-9]{8}$') &&
        d.address is string && d.address.size() >= 5 && d.address.size() <= 300;
    }

    // العميل يعدّل طلبه (الأصناف/الملاحظات/الاسم) طالما المحل ما قبلهوش (status = new).
    // رسوم التوصيل والمحل والحالة ما بتتغيرش، والإجمالي لازم يفضل متسق.
    function validCustomerEdit(n, o) {
      return n.items is list && n.items.size() >= 1 && n.items.size() <= 100 &&
        n.subtotal is number && n.subtotal >= 0 && n.subtotal <= 100000 &&
        n.total is number && n.total > 0 && n.total <= 100000 &&
        math.abs(n.total - (n.subtotal + o.deliveryFee - n.get('discount', 0))) < 0.01 &&
        n.notes is string && n.notes.size() <= 500 &&
        n.customerName is string && n.customerName.size() >= 1 && n.customerName.size() <= 30 &&
        promoOk(n) &&
        n.get('editedAt', null) == request.time;
    }

    // مستند قائمة المندوبين نسخة عامة محدودة من الطلب؛ يجب أن يطابق الطلب بعد الـ Batch.
    // لا يحتوي على أي بيانات تواصل أو معرف العميل.
    function feedMatchesOrder(orderId, orderData) {
      let feedPath = /databases/$(database)/documents/courier_available_orders/$(orderId);
      return existsAfter(feedPath) &&
        feedDataMatchesOrder(getAfter(feedPath).data, orderData);
    }

    function feedDataMatchesOrder(f, orderData) {
      return f.keys().hasOnly(['storeId', 'storeName', 'area', 'items', 'subtotal',
          'deliveryFee', 'finalDeliveryFee', 'discount', 'total', 'status', 'createdAt']) &&
        f.get('storeId', '') == orderData.get('storeId', '') &&
        f.get('storeName', '') == orderData.get('storeName', '') &&
        f.get('area', '') == orderData.get('area', '') &&
        f.get('items', []) == orderData.get('items', []) &&
        f.get('subtotal', -1) == orderData.get('subtotal', -2) &&
        f.get('deliveryFee', -1) == orderData.get('deliveryFee', -2) &&
        f.get('finalDeliveryFee', null) == orderData.get('finalDeliveryFee', null) &&
        f.get('discount', 0) == orderData.get('discount', 0) &&
        f.get('total', -1) == orderData.get('total', -2) &&
        f.get('status', '') == 'preparing' &&
        orderData.get('status', '') == 'preparing' &&
        f.get('createdAt', null) == orderData.get('createdAt', null);
    }

    // اعتماد المدير للإجمالي: لازم رقم معقول، وبختم وقت السيرفر.
    function validVerification(k) {
      return !('verifiedTotal' in k) || (
        request.resource.data.get('verifiedTotal', -1) is number &&
        request.resource.data.verifiedTotal >= 0 &&
        request.resource.data.verifiedTotal <= 100000 &&
        request.resource.data.get('verifiedAt', null) == request.time);
    }

    function userKeys() {
      return ['name', 'phone', 'address', 'lat', 'lng', 'fcmTokens', 'fcmToken',
              'fcmInstallationIds'];
    }

    function validUserFields(d) {
      return (!('name' in d) || (d.name is string && d.name.size() <= 80)) &&
        (!('phone' in d) || (d.phone is string && d.phone.size() <= 20)) &&
        (!('address' in d) || (d.address is string && d.address.size() <= 300)) &&
        (!('lat' in d) || d.lat is number) &&
        (!('lng' in d) || d.lng is number) &&
        (!('fcmToken' in d) || (d.fcmToken is string && d.fcmToken.size() <= 4096)) &&
        (!('fcmTokens' in d) || (d.fcmTokens is list && d.fcmTokens.size() <= 20)) &&
        (!('fcmInstallationIds' in d) ||
          (d.fcmInstallationIds is list && d.fcmInstallationIds.size() <= 20));
    }

    // صنف يكتبه صاحب المحل: حقول معروفة بس وبأنواع صحيحة.
    function validOwnerProduct(d) {
      return d.keys().hasOnly(['name', 'price', 'image', 'available', 'isAvailable',
                               'oldPrice', 'bestSeller', 'createdAt', 'updatedAt',
                               'offerText', 'offerEndsAt']) &&
        (!('oldPrice' in d) || (d.oldPrice is number && d.oldPrice > d.price && d.oldPrice <= 20000)) &&
        (!('offerText' in d) || (d.offerText is string && d.offerText.size() > 0 && d.offerText.size() <= 120)) &&
        (!('offerEndsAt' in d) || d.offerEndsAt is timestamp) &&
        (!('bestSeller' in d) || d.bestSeller is bool) &&
        d.keys().hasAll(['name', 'price']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 120 &&
        d.price is number && d.price > 0 && d.price <= 20000 &&
        (!('image' in d) || (d.image is string && d.image.size() <= 500)) &&
        (!('available' in d) || d.available is bool) &&
        (!('isAvailable' in d) || d.isAvailable is bool);
    }

    // المحلات: القراءة لأي مستخدم مسجّل، والكتابة للمدير.
    // صاحب المحل يعدّل محله هو فقط، وحقول التشغيل بس (فتح/إغلاق، مواعيد، صورة).
    // الاسم والقسم والترتيب والتقييم للمدير فقط.
    // مسودات المحلات خاصة بصاحبها والإدارة، والعملاء لا يرون إلا المحلات النشطة.
    function validStoreDraft(storeId, d) {
      let requestPath = /databases/$(database)/documents/role_requests/$(request.auth.uid + '_store_owner');
      return signedIn() &&
        d.keys().hasOnly(['name', 'category', 'address', 'ownerUid', 'active', 'approved',
                          'time', 'image', 'imageUrl', 'storePhone', 'productCount',
                          'createdAt', 'updatedAt']) &&
        d.keys().hasAll(['name', 'category', 'address', 'ownerUid', 'active', 'approved',
                         'time', 'image', 'imageUrl', 'productCount', 'createdAt']) &&
        d.ownerUid == request.auth.uid &&
        d.active == false && d.approved == false &&
        d.createdAt == request.time &&
        d.name is string && d.name.size() >= 2 && d.name.size() <= 100 &&
        d.category is string && d.category.size() > 0 && d.category.size() <= 60 &&
        d.address is string && d.address.size() >= 5 && d.address.size() <= 300 &&
        d.imageUrl is string && d.imageUrl.matches('https://.*') &&
        d.image == d.imageUrl &&
        d.get('storePhone', '') is string && d.get('storePhone', '').size() <= 20 &&
        d.productCount == 0 &&
        existsAfter(requestPath) &&
        getAfter(requestPath).data.get('type', '') == 'store_owner' &&
        getAfter(requestPath).data.get('status', '') == 'pending' &&
        getAfter(requestPath).data.get('storeId', '') == storeId &&
        getAfter(requestPath).data.get('storeName', '') == d.name &&
        getAfter(requestPath).data.get('storeCategory', '') == d.category &&
        getAfter(requestPath).data.get('address', '') == d.address &&
        getAfter(requestPath).data.get('storeImageUrl', '') == d.imageUrl &&
        getAfter(requestPath).data.get('storePhone', '') == d.get('storePhone', '');
    }

    match /stores/{storeId} {
      allow get: if isAdmin() || isStoreOwner(storeId) ||
        isStoreApplicant(storeId) || resource.data.get('active', true) == true;
      allow list: if isAdmin() || resource.data.get('active', true) == true;
      allow create: if isAdmin() || validStoreDraft(storeId, request.resource.data);
      allow delete: if isAdmin() || isStoreOwner(storeId);
      allow update: if isAdmin() ||
        (isStoreOwner(storeId) &&
          changedKeys().hasOnly(['active', 'time', 'image', 'imageUrl',
                                 'productCount', 'offerItems', 'bestItems',
                                 'updatedAt']) &&
          request.resource.data.get('active', true) is bool &&
          (!('active' in changedKeys()) || request.resource.data.active == false) &&
          request.resource.data.get('time', '') is string &&
          request.resource.data.get('time', '').size() <= 60 &&
          request.resource.data.get('image', '') is string &&
          request.resource.data.get('image', '').size() <= 1000 &&
          request.resource.data.get('imageUrl', '') is string &&
          request.resource.data.get('imageUrl', '').size() <= 1000 &&
          (!('productCount' in changedKeys()) ||
            (request.resource.data.productCount is int &&
             request.resource.data.productCount >= 0 &&
             request.resource.data.productCount <= 10000)) &&
          (!('offerItems' in changedKeys()) ||
            (request.resource.data.offerItems is list &&
             request.resource.data.offerItems.size() <= 12)) &&
          (!('bestItems' in changedKeys()) ||
            (request.resource.data.bestItems is list &&
             request.resource.data.bestItems.size() <= 12))) ||
        (isStoreApplicant(storeId) &&
          changedKeys().hasOnly(['name', 'category', 'address', 'time', 'image',
                                 'imageUrl', 'storePhone', 'productCount',
                                 'offerItems', 'bestItems', 'updatedAt']) &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.active == false &&
          request.resource.data.approved == false &&
          request.resource.data.name is string &&
          request.resource.data.name.size() >= 2 &&
          request.resource.data.name.size() <= 100 &&
          request.resource.data.category is string &&
          request.resource.data.category.size() <= 60 &&
          request.resource.data.address is string &&
          request.resource.data.address.size() <= 300 &&
          request.resource.data.image is string &&
          request.resource.data.image.size() <= 1000 &&
          request.resource.data.imageUrl is string &&
          request.resource.data.imageUrl.size() <= 1000 &&
          request.resource.data.get('storePhone', '') is string &&
          request.resource.data.get('storePhone', '').size() <= 20 &&
          (!('productCount' in changedKeys()) ||
            (request.resource.data.productCount is int &&
             request.resource.data.productCount >= 0 &&
             request.resource.data.productCount <= 10000)) &&
          (!('offerItems' in changedKeys()) ||
            (request.resource.data.offerItems is list &&
             request.resource.data.offerItems.size() <= 12)) &&
          (!('bestItems' in changedKeys()) ||
            (request.resource.data.bestItems is list &&
             request.resource.data.bestItems.size() <= 12)));

      allow update: if signedIn() &&
        changedKeys().hasOnly(['ratingSum', 'ratingCount', 'lastReviewId']) &&
        request.resource.data.lastReviewId is string &&
        !exists(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)) &&
        existsAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)) &&
        getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)).data.storeId == storeId &&
        request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1 &&
        request.resource.data.ratingSum ==
          resource.data.get('ratingSum', 0) +
          getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)).data.rating;

      match /products/{productId} {
        allow read: if isAdmin() || isStoreOwner(storeId) ||
          isStoreApplicant(storeId) || isPublicStore(storeId);
        allow delete: if isAdmin() || isStoreOwner(storeId) ||
          isStoreApplicant(storeId);
        allow create, update: if isAdmin() ||
          ((isStoreOwner(storeId) || isStoreApplicant(storeId)) &&
            validOwnerProduct(request.resource.data));
      }
    }

    match /account_deletions/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 200;
      allow read: if isAdmin();
    }

    // البوسترات: القراءة لأي مستخدم مسجّل، والكتابة للمدير فقط.
    match /banners/{bannerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // (قديم) علامة التوصيل المجاني لأول طلب: الميزة اتلغت من التطبيق، والقاعدة دي سايبينها
    // عشان النسخ القديمة من التطبيق (لو لسه متثبتة عند حد) ما تفشلش. تقدر تشيلها بعد ما الكل يحدّث.
    match /first_orders/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['orderId', 'createdAt']) &&
        request.resource.data.orderId is string &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // قائمة الطلبات المتاحة للمندوبين (من غير بيانات العميل). بتتكتب من التطبيق (بدون Cloud Functions):
    // المدير أو صاحب المحل بتاع الطلب، لما الطلب يبقى preparing وبدون مندوب.
    match /courier_available_orders/{orderId} {
      allow get, list: if isCourier();

      allow create: if signedIn() &&
        (isAdmin() ||
         isStoreOwner(getAfter(/databases/$(database)/documents/orders/$(orderId)).data.get('storeId', ''))) &&
        getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status == 'preparing' &&
        getAfter(/databases/$(database)/documents/orders/$(orderId)).data.get('courierId', '') == '' &&
        request.resource.data.storeId ==
          getAfter(/databases/$(database)/documents/orders/$(orderId)).data.storeId &&
        request.resource.data.keys().hasOnly(['storeId', 'storeName', 'area', 'items', 'subtotal',
          'deliveryFee', 'finalDeliveryFee', 'discount', 'total', 'status', 'createdAt']);

      // العميل صاحب الطلب يحدّث نسخة القائمة في نفس Batch تعديل الطلب فقط.
      // getAfter يربط المستندين بالقيم النهائية ويمنع إدخال أي PII.
      allow update: if signedIn() &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.get('userId', '') == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.get('status', '') == 'preparing' &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.get('courierId', '') == '' &&
        getAfter(/databases/$(database)/documents/orders/$(orderId)).data.get('editedAt', null) == request.time &&
        feedMatchesOrder(orderId, getAfter(/databases/$(database)/documents/orders/$(orderId)).data);

      allow delete: if signedIn() && (isAdmin() ||
        isStoreOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.get('storeId', '')) ||
        // getAfter: المندوب بيحذف عنصر القايمة في نفس الـ batch اللي بيستلم فيه الطلب.
        (isCourier() &&
          getAfter(/databases/$(database)/documents/orders/$(orderId)).data.get('courierId', '') == request.auth.uid));
    }

    match /orders/{orderId} {
      // كل التعديلات في دالة واحدة (evalOrderUpdate) بتحسب diff().affectedKeys() مرة واحدة (k)
      // وبتبدأ كل فرع بالتحقق السريع من الهوية (حقول المستند) قبل أي استدعاء لقاعدة البيانات.
      // let مسموح جوه الدوال بس، مش جوه تعبير allow.

      // العميل: يعدّل طلبه أو يلغيه طالما لسه جديد (المحل ما قبلهوش).
      function canCustomerUpdate(k) {
        return (
          (!securityFlag('serverOrders') &&
            resource.data.get('status', '') in ['new', 'preparing'] &&
            resource.data.get('courierId', '') == '' &&
            'editedAt' in k &&
            k.hasOnly(['items', 'subtotal', 'total', 'notes', 'discount',
                       'promoCode', 'customerName', 'editedAt', 'unavailableItems']) &&
            // تعديل العميل لازم يشيل علامة «صنف غير متاح» (لو كانت موجودة) في نفس العملية.
            !('unavailableItems' in request.resource.data) &&
            validCustomerEdit(request.resource.data, resource.data) &&
            (resource.data.get('status', '') != 'preparing' ||
              feedMatchesOrder(orderId, request.resource.data)))
          ||
          (resource.data.get('status', '') == 'new' &&
            k.hasOnly(['status']) &&
            request.resource.data.get('status', '') == 'cancelled' &&
            historyGate(orderId, k))
        );
      }

      // المندوب: يستلم طلب جاهز (preparing) ومحدّش خده (ذرّي بشرط resource.data)،
      // أو يغيّر حالة طلبه هو ويختم التسليم.
      function canCourierUpdate(k) {
        return (
          resource.data.get('status', '') == 'preparing' &&
          resource.data.get('courierId', '') == '' &&
          k.hasOnly(['courierId', 'courierName', 'courierPhone', 'courierAt']) &&
          request.resource.data.get('courierId', '') == request.auth.uid &&
          request.resource.data.get('courierName', '') is string &&
          request.resource.data.get('courierName', '').size() >= 1 &&
          request.resource.data.get('courierName', '').size() <= 80 &&
          request.resource.data.get('courierPhone', '') is string &&
          request.resource.data.get('courierPhone', '').size() <= 20 &&
          request.resource.data.get('courierAt', null) == request.time
        ) || (
          // تسجيل الوصول عند العميل دون تغيير حالة الطلب.
          resource.data.get('status', '') == 'on_the_way' &&
          resource.data.get('courierId', '') == request.auth.uid &&
          !('activeDeliveryIssueId' in resource.data) &&
          k.hasOnly(['courierArrivedAt']) &&
          request.resource.data.get('courierArrivedAt', null) == request.time
        ) || (
          // فتح بلاغ تعذر التسليم في Batch واحدة مع ربطه بالطلب.
          resource.data.get('status', '') == 'on_the_way' &&
          resource.data.get('courierId', '') == request.auth.uid &&
          !('activeDeliveryIssueId' in resource.data) &&
          k.hasOnly(['activeDeliveryIssueId']) &&
          request.resource.data.get('activeDeliveryIssueId', '') is string &&
          request.resource.data.get('activeDeliveryIssueId', '').size() > 0 &&
          existsAfter(/databases/$(database)/documents/delivery_issues/$(request.resource.data.get('activeDeliveryIssueId', ''))) &&
          getAfter(/databases/$(database)/documents/delivery_issues/$(request.resource.data.get('activeDeliveryIssueId', ''))).data.get('orderId', '') == orderId &&
          getAfter(/databases/$(database)/documents/delivery_issues/$(request.resource.data.get('activeDeliveryIssueId', ''))).data.get('courierId', '') == request.auth.uid &&
          getAfter(/databases/$(database)/documents/delivery_issues/$(request.resource.data.get('activeDeliveryIssueId', ''))).data.get('status', '') == 'open'
        ) || (
          // استئناف الرحلة بعد موافقة الإدارة على إعادة المحاولة.
          resource.data.get('status', '') == 'on_the_way' &&
          resource.data.get('courierId', '') == request.auth.uid &&
          resource.data.get('activeDeliveryIssueId', '') is string &&
          resource.data.get('activeDeliveryIssueId', '').size() > 0 &&
          k.hasOnly(['activeDeliveryIssueId']) &&
          !('activeDeliveryIssueId' in request.resource.data) &&
          get(/databases/$(database)/documents/delivery_issues/$(resource.data.get('activeDeliveryIssueId', ''))).data.get('status', '') == 'retry' &&
          getAfter(/databases/$(database)/documents/delivery_issues/$(resource.data.get('activeDeliveryIssueId', ''))).data.get('status', '') == 'resolved' &&
          getAfter(/databases/$(database)/documents/delivery_issues/$(resource.data.get('activeDeliveryIssueId', ''))).data.get('courierResumedBy', '') == request.auth.uid &&
          getAfter(/databases/$(database)/documents/delivery_issues/$(resource.data.get('activeDeliveryIssueId', ''))).data.get('courierResumedAt', null) == request.time
        ) || (
          resource.data.get('courierId', '') == request.auth.uid &&
          k.hasOnly(['status', 'pickedUpAt', 'deliveredBy', 'deliveredAt', 'collectedAmount', 'courierEarning']) &&
          deliveryStampOk(request.auth.uid, k) &&
          stampRequired(k) &&
          ((resource.data.get('status', '') == 'preparing' &&
              request.resource.data.get('status', '') == 'on_the_way' &&
              resource.data.get('ready', false) == true &&
              request.resource.data.get('pickedUpAt', null) == request.time) ||
           (resource.data.get('status', '') == 'on_the_way' &&
              request.resource.data.get('status', '') == 'delivered' &&
              (resource.data.get('pickedUpAt', null) is timestamp ||
               resource.data.get('courierAt', null) is timestamp) &&
              resource.data.get('courierArrivedAt', null) is timestamp &&
              !('activeDeliveryIssueId' in resource.data))) &&
          historyGate(orderId, k)
        );
      }

      // صاحب المحل (محل الطلب فقط): قبول/رفض، «جاهز للاستلام»، وتعيين مندوب.
      function canOwnerUpdate(k) {
        return (
          resource.data.get('status', '') == 'new' &&
          k.hasOnly(['status']) &&
          request.resource.data.get('status', '') in ['preparing', 'cancelled'] &&
          // مينفعش يبدأ التجهيز طالما فيه صنف معلّم «غير متاح» (العميل لازم يرد الأول). الرفض متاح دايمًا.
          (request.resource.data.get('status', '') == 'cancelled' ||
            !('unavailableItems' in resource.data)) &&
          historyGate(orderId, k)
        ) || (
          // «صنف غير متاح»: المحل يعلّم أصناف ناقصة على طلب جديد (أو يشيل العلامة).
          resource.data.get('status', '') == 'new' &&
          resource.data.get('courierId', '') == '' &&
          k.hasOnly(['unavailableItems']) &&
          (!('unavailableItems' in request.resource.data) ||
            (request.resource.data.unavailableItems is list &&
             request.resource.data.unavailableItems.size() >= 1 &&
             request.resource.data.unavailableItems.size() <= 20))
        ) || (
          resource.data.get('status', '') == 'preparing' &&
          k.hasOnly(['ready', 'readyAt']) &&
          request.resource.data.get('ready', false) == true &&
          request.resource.data.get('readyAt', null) == request.time
        ) || (
          resource.data.get('status', '') == 'preparing' &&
          resource.data.get('courierId', '') == '' &&
          k.hasOnly(['courierId', 'courierName', 'courierPhone', 'courierAt']) &&
          request.resource.data.get('courierName', '') is string &&
          request.resource.data.get('courierName', '').size() >= 1 &&
          request.resource.data.get('courierName', '').size() <= 80 &&
          request.resource.data.get('courierPhone', '') is string &&
          request.resource.data.get('courierPhone', '').size() <= 20 &&
          request.resource.data.get('courierAt', null) == request.time &&
          validCourierForAssignment(request.resource.data.get('courierId', '')) &&
          // التعيين وإزالة الطلب من القائمة العامة لازم يكونا ذريين.
          !existsAfter(/databases/$(database)/documents/courier_available_orders/$(orderId))
        );
      }

      // الأدمن: «جاهز للاستلام»، إلغاء تعيين المندوب، واعتماد الحالة/الإجمالي/رسوم التوصيل (+ التعيين).
      // محتوى الطلب نفسه (الأصناف والأسعار والإجمالي الأصلي) ما يتعدّلش أبدًا.
      function canAdminUpdate(k) {
        return (
          // «جاهز للاستلام» (كان مسموح للمدير في القواعد الأصلية، فاتحافظ عليه)
          resource.data.get('status', '') == 'preparing' &&
          k.hasOnly(['ready', 'readyAt']) &&
          request.resource.data.get('ready', false) == true &&
          request.resource.data.get('readyAt', null) == request.time
        ) || (
          resource.data.get('status', '') == 'preparing' &&
          resource.data.get('courierId', '') != '' &&
          k.hasOnly(['courierId', 'courierName', 'courierPhone', 'courierAt']) &&
          !('courierId' in request.resource.data) &&
          // إعادة إتاحة الطلب لا تتم إلا مع إعادة بناء الـ feed المطابق في نفس العملية.
          feedMatchesOrder(orderId, request.resource.data)
        ) || (
          // إلغاء إداري أثناء التجهيز: إغلاق الطلب وإزالة إسناد المندوب في نفس التحديث.
          resource.data.get('status', '') == 'preparing' &&
          request.resource.data.get('status', '') == 'cancelled' &&
          k.hasOnly(['status', 'courierId', 'courierName', 'courierPhone', 'courierAt']) &&
          !('courierId' in request.resource.data) &&
          historyGate(orderId, k)
        ) || (
          // إغلاق طلب في الطريق لا يسمح به إلا بعد توثيق رجوعه فعليًا للمحل.
          resource.data.get('status', '') == 'on_the_way' &&
          request.resource.data.get('status', '') == 'cancelled' &&
          resource.data.get('activeDeliveryIssueId', '') is string &&
          resource.data.get('activeDeliveryIssueId', '').size() > 0 &&
          get(/databases/$(database)/documents/delivery_issues/$(resource.data.get('activeDeliveryIssueId', ''))).data.get('status', '') == 'store_confirmed_return' &&
          k.hasOnly(['status', 'activeDeliveryIssueId', 'lastDeliveryIssueId']) &&
          !('activeDeliveryIssueId' in request.resource.data) &&
          request.resource.data.get('lastDeliveryIssueId', '') == resource.data.get('activeDeliveryIssueId', '') &&
          historyGate(orderId, k)
        ) || (
          k.hasOnly(['status', 'pickedUpAt', 'courierId', 'courierName',
                     'courierPhone', 'courierAt', 'verifiedTotal', 'verifiedAt',
                     'deliveredBy', 'deliveredAt', 'collectedAmount',
                     'courierEarning', 'finalDeliveryFee']) &&
          validFinalFee(k) &&
          validStatus(request.resource.data.get('status', '')) &&
          validVerification(k) &&
          deliveryStampOk(resource.data.get('courierId', ''), k) &&
          stampRequired(k) &&
          (!('courierId' in k) ||
            (resource.data.get('courierId', '') == '' &&
             validCourierForAssignment(request.resource.data.get('courierId', '')) &&
             // يمنع إعادة تعيين مندوب فوق إسناد قائم أو بقاء نسخة قديمة في القائمة.
             !existsAfter(/databases/$(database)/documents/courier_available_orders/$(orderId)))) &&
          adminMoveOk(k) &&
          historyGate(orderId, k)
        );
      }

      function evalOrderUpdate() {
        let k = request.resource.data.diff(resource.data).affectedKeys();
        return (resource.data.get('userId', '') == request.auth.uid &&
            ((k.hasOnly(['customerHidden']) && request.resource.data.get('customerHidden', false) == true) || canCustomerUpdate(k))) ||
          ((resource.data.get('courierId', '') == request.auth.uid ||
            resource.data.get('courierId', '') == '') &&
            isCourier() && canCourierUpdate(k)) ||
          (resource.data.get('storeId', '') != '' &&
            isStoreOwner(resource.data.get('storeId', '')) && canOwnerUpdate(k)) ||
          (isAdmin() && canAdminUpdate(k));
      }

      // العميل يشوف طلباته، والمندوب الطلبات المكلّف بيها، والمدير كل الطلبات.
      allow read: if signedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('courierId', '') == request.auth.uid ||
        isAdmin() ||
        isStoreOwner(resource.data.get('storeId', ''))
      );

      // العميل ينشئ طلب باسمه وبحالة new، بحقول محددة وحدود معقولة (validNewOrder).
      allow create: if !securityFlag('serverOrders') && signedIn() && validNewOrder(request.resource.data) && orderRateOk(request.auth.uid);

      allow update: if signedIn() && evalOrderUpdate();

      // العميل يحذف طلبه طالما لسه جديد (المحل ما قبلهوش). باقي الحالات: إلغاء بس.
      allow delete: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'new';

      // ───────────── بيانات العميل الشخصية (خاصة) ─────────────
      // orders/{id}/private/contact = { userName, phone, address, courierNotes? }.
      //  • القراءة: العميل صاحب الطلب، والمدير، والمندوب المكلّف بالطلب وهو لسه جاري فقط
      //    (preparing / on_the_way). صاحب المحل والمناديب التانيين مفيش لهم وصول.
      //  • الإنشاء: العميل مع طلبه في نفس الـ batch فقط. مفيش تعديل ولا حذف من التطبيق.
      match /private/{doc} {
        allow read: if signedIn() && doc == 'contact' && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
          isAdmin() ||
          (isCourier() &&
            get(/databases/$(database)/documents/orders/$(orderId)).data.get('courierId', '') == request.auth.uid &&
            get(/databases/$(database)/documents/orders/$(orderId)).data.status in ['preparing', 'on_the_way']));
        allow create: if signedIn() && doc == 'contact' &&
          !exists(/databases/$(database)/documents/orders/$(orderId)) &&
          existsAfter(/databases/$(database)/documents/orders/$(orderId)) &&
          getAfter(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid &&
          validContact(request.resource.data);
        // العميل يعدّل بيانات التواصل حتى استلام المندوب، ويحذفها فقط مع طلب new.
        allow update: if signedIn() && doc == 'contact' &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.status in ['new', 'preparing'] &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.get('courierId', '') == '' &&
          validContact(request.resource.data);
        allow delete: if signedIn() && doc == 'contact' &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'new' &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.get('courierId', '') == '';
      }

      // سجل الحالات: create فقط. معرّف المستند = الحالة الجديدة، فمفيش حدث بيتكرر.
      // لازم يتكتب في نفس الـ batch اللي بيغيّر حالة الطلب.
      // المناديب المتقدّمين على الطلب: المندوب بيسجّل نفسه (طلب اهتمام) والمدير هو اللي يختار
      // ويعيّن بـ assignCourier. التقديم مش بيغيّر الطلب نفسه.
      match /applicants/{cid} {
        allow get: if signedIn() && (cid == request.auth.uid || isAdmin() ||
          isStoreOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.get('storeId', '')));
        allow list: if signedIn() && (isAdmin() ||
          isStoreOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.get('storeId', '')));
        allow create: if isCourier() && cid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['courierId', 'courierName', 'courierPhone', 'createdAt']) &&
          request.resource.data.keys().hasAll(['courierId', 'courierName', 'createdAt']) &&
          request.resource.data.courierId == request.auth.uid &&
          request.resource.data.courierName is string &&
          request.resource.data.courierName.size() <= 80 &&
          request.resource.data.get('courierPhone', '') is string &&
          request.resource.data.get('courierPhone', '').size() <= 20 &&
          request.resource.data.createdAt == request.time &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'preparing' &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.get('courierId', '') == '';
        allow update: if false;
        allow delete: if isAdmin() || (isCourier() && cid == request.auth.uid);
      }

      match /statusHistory/{evt} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
          isAdmin() ||
          (isCourier() &&
            get(/databases/$(database)/documents/orders/$(orderId)).data.get('courierId', '') == request.auth.uid) ||
          isStoreOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.get('storeId', '')));
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['from', 'to', 'actorUid', 'actorRole', 'at']) &&
          request.resource.data.keys().hasAll(['from', 'to', 'actorUid', 'actorRole', 'at']) &&
          evt == request.resource.data.to &&
          validStatus(request.resource.data.to) &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.at == request.time &&
          request.resource.data.from ==
            get(/databases/$(database)/documents/orders/$(orderId)).data.status &&
          getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status ==
            request.resource.data.to &&
          ((request.resource.data.actorRole == 'admin' && isAdmin()) ||
           (request.resource.data.actorRole == 'courier' && isCourier()) ||
           (request.resource.data.actorRole in ['owner', 'storeOwner'] &&
              isStoreOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.get('storeId', ''))) ||
           (request.resource.data.actorRole == 'customer' &&
              get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid));
        allow update, delete: if false;
      }
    }

    // بيانات المستخدم: صاحبها بس.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // ممنوع المستخدم يكتب حقل role (أو أي حقل صلاحيات) في مستنده.
      // الحقول المسموحة بس (whitelist). أي حقل جديد (محفظة، صلاحيات...) لازم يتضاف هنا صراحةً.
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(userKeys()) &&
        validUserFields(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(userKeys()) &&
        validUserFields(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // معلومات التطبيق (app_info/*): contact, version, security, delivery_areas, catalog...
    // القراءة لأي مستخدم مسجّل. الكتابة للمدير، ما عدا app_info/catalog (رقم إصدار الكتالوج)
    // فمسموح كمان لأي صاحب محل بحقلين بس (version, updatedAt).
    // (كانت قاعدتين match مكررتين لنفس المسار، اتدمجوا في واحدة بنفس الصلاحيات بالظبط.)
    match /app_info/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin() ||
        (doc == 'catalog' && isAnyStoreOwner() &&
          request.resource.data.keys().hasOnly(['version', 'updatedAt']) &&
          request.resource.data.version is number);
    }

    // آخر وقت طلب لكل عميل (للفاصل بين الطلبات). العميل يكتبه بس مع طلبه؛ مفيش قراءة ولا حذف.
    match /orderLimits/{uid} {
      allow create, update: if !securityFlag('serverOrders') && signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['lastAt']) &&
        request.resource.data.lastAt == request.time;
      allow read, delete: if false;
    }

    // المديرين: كل مستخدم يقرأ مستنده هو بس، والكتابة من الـ Console فقط.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ───────────── الإشعارات داخل التطبيق ─────────────
    // العميل (أو المندوب) يقرأ إشعاراته هو بس، ويعلّمها مقروءة أو يمسحها.
    // الكتابة (إنشاء) من المدير أو المندوب بس، بحقول محددة (StaffOrderService._notify).
    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      // الإشعار لازم يتعلّق بطلب حقيقي: المستلم هو عميل الطلب أو مندوبه، والكاتب هو المدير أو
      // مندوب الطلب أو صاحب المحل بتاعه (يمنع إرسال رسائل لأي مستخدم عشوائي).
      allow create: if signedIn() &&
        request.resource.data.get('orderId', '') is string &&
        request.resource.data.orderId.size() > 0 &&
        exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId)) &&
        (get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId ==
           request.resource.data.userId ||
         get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.get('courierId', '') ==
           request.resource.data.userId) &&
        (isAdmin() ||
         (isCourier() &&
           get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.get('courierId', '') ==
             request.auth.uid) ||
         isStoreOwner(get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.get('storeId', ''))) &&
        request.resource.data.keys().hasOnly(
          ['userId', 'title', 'body', 'orderId', 'read', 'createdAt']) &&
        request.resource.data.userId is string &&
        request.resource.data.title is string &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() <= 300 &&
        request.resource.data.orderId is string &&
        request.resource.data.read == false &&
        request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        changedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ───────────── تقييم المندوب ─────────────
    // معرّف التقييم = orderId + '_courier'، فالطلب الواحد يتقيّم مرة واحدة.
    // التقييم والتحديث التراكمي لمستند المندوب (ratingSum/ratingCount) لازم يتكتبوا
    // في نفس الـ batch، والقواعد بتربط الاتنين ببعض (getAfter / existsAfter).
    function validCourierReview(rid, d) {
      return d.keys().hasOnly(['orderId', 'courierId', 'userId', 'rating',
                               'comment', 'createdAt']) &&
        d.keys().hasAll(['orderId', 'courierId', 'userId', 'rating',
                         'comment', 'createdAt']) &&
        d.orderId is string && d.courierId is string && d.courierId.size() > 0 &&
        rid == d.orderId + '_courier' &&
        d.userId == request.auth.uid &&
        d.rating is int && d.rating >= 1 && d.rating <= 5 &&
        d.comment is string && d.comment.size() <= 300 &&
        d.createdAt == request.time &&
        get(/databases/$(database)/documents/orders/$(d.orderId)).data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(d.orderId)).data.status == 'delivered' &&
        get(/databases/$(database)/documents/orders/$(d.orderId)).data.get('courierId', '') == d.courierId &&
        getAfter(/databases/$(database)/documents/couriers/$(d.courierId)).data.get('lastReviewId', '') == rid;
    }

    // تقييم المحل: reviews/{orderId}_store بعد تسليم الطلب، مرة واحدة لكل طلب.
    function validStoreReview(rid, d) {
      return d.keys().hasOnly(['orderId', 'storeId', 'userId', 'rating',
                               'comment', 'createdAt']) &&
        d.keys().hasAll(['orderId', 'storeId', 'userId', 'rating',
                         'comment', 'createdAt']) &&
        d.orderId is string && d.storeId is string && d.storeId.size() > 0 &&
        rid == d.orderId + '_store' &&
        d.userId == request.auth.uid &&
        d.rating is int && d.rating >= 1 && d.rating <= 5 &&
        d.comment is string && d.comment.size() <= 300 &&
        d.createdAt == request.time &&
        get(/databases/$(database)/documents/orders/$(d.orderId)).data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(d.orderId)).data.status == 'delivered' &&
        get(/databases/$(database)/documents/orders/$(d.orderId)).data.get('storeId', '') == d.storeId &&
        getAfter(/databases/$(database)/documents/stores/$(d.storeId)).data.get('lastReviewId', '') == rid;
    }

    // تقييم العميل من المندوب أو صاحب المحل: سجل داخلي لا يراه العميل.
    function validCustomerReview(rid, d) {
      let order = get(/databases/$(database)/documents/orders/$(d.orderId)).data;
      return d.keys().hasOnly(['orderId', 'customerId', 'reviewerId', 'reviewerRole',
                               'storeId', 'rating', 'reason', 'comment', 'createdAt']) &&
        d.keys().hasAll(['orderId', 'customerId', 'reviewerId', 'reviewerRole',
                         'storeId', 'rating', 'reason', 'comment', 'createdAt']) &&
        d.orderId is string && d.orderId.size() > 0 &&
        order != null &&
        rid == d.orderId + '_' + d.reviewerRole &&
        d.customerId is string && d.reviewerId == request.auth.uid &&
        d.reviewerRole in ['courier', 'store_owner'] &&
        d.storeId is string && d.storeId.size() > 0 &&
        d.rating is int && d.rating >= 1 && d.rating <= 5 &&
        d.reason in ['positive', 'unavailable', 'wrong_address', 'refused_order',
                     'no_cash', 'abusive_behavior', 'other'] &&
        (d.rating > 3 || d.reason != 'positive') &&
        d.comment is string && d.comment.size() <= 300 &&
        d.createdAt == request.time &&
        order.get('userId', '') == d.customerId &&
        order.get('storeId', '') == d.storeId &&
        ((d.reviewerRole == 'courier' && isCourier() &&
            ((order.get('status', '') == 'delivered' &&
              order.get('courierId', '') == request.auth.uid &&
              order.get('deliveredBy', '') == request.auth.uid) ||
             (order.get('status', '') == 'cancelled' &&
              order.get('lastDeliveryIssueId', '') is string &&
              order.get('lastDeliveryIssueId', '').size() > 0 &&
              order.get('courierId', '') == request.auth.uid &&
              get(/databases/$(database)/documents/delivery_issues/$(order.get('lastDeliveryIssueId', ''))).data.get('status', '') == 'store_confirmed_return' &&
              get(/databases/$(database)/documents/delivery_issues/$(order.get('lastDeliveryIssueId', ''))).data.get('courierId', '') == request.auth.uid))) ||
         (d.reviewerRole == 'store_owner' && isStoreOwner(d.storeId) &&
            order.get('status', '') == 'delivered'));
    }

    function validCustomerRestriction(uid, d) {
      let sourceOrder = get(/databases/$(database)/documents/orders/$(d.sourceOrderId)).data;
      return d.keys().hasOnly(['customerId', 'active', 'reason', 'sourceOrderId',
                               'createdAt', 'createdBy', 'expiresAt']) &&
        d.keys().hasAll(['customerId', 'active', 'reason', 'sourceOrderId',
                         'createdAt', 'createdBy', 'expiresAt']) &&
        d.customerId == uid && d.active == true &&
        d.reason is string && d.reason.size() >= 5 && d.reason.size() <= 300 &&
        d.sourceOrderId is string && d.sourceOrderId.size() > 0 &&
        d.createdAt == request.time && d.createdBy == request.auth.uid &&
        d.expiresAt is timestamp && d.expiresAt > request.time &&
        sourceOrder != null && sourceOrder.get('userId', '') == uid;
    }

    function validDeliveryIssue(issueId, d) {
      let order = get(/databases/$(database)/documents/orders/$(d.orderId)).data;
      return d.keys().hasOnly(['orderId', 'courierId', 'customerId', 'storeId',
                               'reason', 'note', 'contactAttempted', 'status',
                               'createdBy', 'createdAt']) &&
        d.keys().hasAll(['orderId', 'courierId', 'customerId', 'storeId',
                         'reason', 'note', 'contactAttempted', 'status',
                         'createdBy', 'createdAt']) &&
        d.orderId is string && d.courierId == request.auth.uid &&
        d.customerId is string && d.storeId is string &&
        d.reason in ['no_answer', 'wrong_address', 'refused_order', 'no_cash',
                     'customer_requested_delay', 'unsafe_location', 'other'] &&
        d.note is string && d.note.size() <= 300 &&
        d.contactAttempted == true && d.status == 'open' &&
        d.createdBy == request.auth.uid && d.createdAt == request.time &&
        order != null &&
        order.get('status', '') == 'on_the_way' &&
        order.get('courierId', '') == request.auth.uid &&
        (order.get('pickedUpAt', null) is timestamp ||
         order.get('courierAt', null) is timestamp) &&
        order.get('courierArrivedAt', null) is timestamp &&
        order.get('userId', '') == d.customerId &&
        order.get('storeId', '') == d.storeId;
    }

    match /delivery_issues/{issueId} {
      allow get, list: if signedIn() &&
        (isAdmin() || resource.data.get('courierId', '') == request.auth.uid ||
         resource.data.get('customerId', '') == request.auth.uid ||
         isStoreOwner(resource.data.get('storeId', '')));
      allow create: if signedIn() && isCourier() &&
        validDeliveryIssue(issueId, request.resource.data);
      allow update: if (
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminDecision', 'updatedAt', 'updatedBy'
        ]) &&
        request.resource.data.get('adminDecision', '') is string &&
        request.resource.data.get('adminDecision', '').size() <= 300 &&
        request.resource.data.get('updatedAt', null) == request.time &&
        request.resource.data.get('updatedBy', '') == request.auth.uid &&
        ((resource.data.get('status', '') in ['open', 'in_review'] &&
          request.resource.data.get('status', '') in ['in_review', 'retry', 'return_to_store']) ||
         (resource.data.get('status', '') == 'returned_to_store' &&
          request.resource.data.get('status', '') == 'store_confirmed_return'))
      ) || (
        signedIn() &&
        resource.data.get('courierId', '') == request.auth.uid &&
        exists(/databases/$(database)/documents/orders/$(resource.data.get('orderId', ''))) &&
        get(/databases/$(database)/documents/orders/$(resource.data.get('orderId', ''))).data.get('courierId', '') == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(resource.data.get('orderId', ''))).data.get('activeDeliveryIssueId', '') == issueId &&
        resource.data.get('status', '') == 'retry' &&
        request.resource.data.get('status', '') == 'resolved' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'courierResumedAt', 'courierResumedBy'
        ]) &&
        request.resource.data.get('courierResumedAt', null) == request.time &&
        request.resource.data.get('courierResumedBy', '') == request.auth.uid
      ) || (
        signedIn() &&
        resource.data.get('courierId', '') == request.auth.uid &&
        exists(/databases/$(database)/documents/orders/$(resource.data.get('orderId', ''))) &&
        get(/databases/$(database)/documents/orders/$(resource.data.get('orderId', ''))).data.get('courierId', '') == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(resource.data.get('orderId', ''))).data.get('activeDeliveryIssueId', '') == issueId &&
        resource.data.get('status', '') == 'return_to_store' &&
        request.resource.data.get('status', '') == 'returned_to_store' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'returnedAt', 'returnedBy'
        ]) &&
        request.resource.data.get('returnedAt', null) == request.time &&
        request.resource.data.get('returnedBy', '') == request.auth.uid
      ) || (
        signedIn() &&
        isStoreOwner(resource.data.get('storeId', '')) &&
        resource.data.get('status', '') == 'returned_to_store' &&
        exists(/databases/$(database)/documents/orders/$(resource.data.get('orderId', ''))) &&
        get(/databases/$(database)/documents/orders/$(resource.data.get('orderId', ''))).data.get('status', '') == 'on_the_way' &&
        get(/databases/$(database)/documents/orders/$(resource.data.get('orderId', ''))).data.get('activeDeliveryIssueId', '') == issueId &&
        request.resource.data.get('status', '') == 'store_confirmed_return' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'storeReceivedAt', 'storeReceivedBy'
        ]) &&
        request.resource.data.get('storeReceivedAt', null) == request.time &&
        request.resource.data.get('storeReceivedBy', '') == request.auth.uid
      );
      allow delete: if false;
    }

    match /customer_reviews/{rid} {
      allow get, list: if signedIn() &&
        (isAdmin() || resource.data.get('reviewerId', '') == request.auth.uid);
      allow create: if signedIn() && validCustomerReview(rid, request.resource.data);
      // لا نغيّر التقييم الأصلي؛ الإدارة فقط تستطيع استبعاده بعد مراجعة موثقة.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStatus', 'adminNote', 'moderatedAt', 'moderatedBy'
        ]) &&
        request.resource.data.get('moderationStatus', '') in ['excluded', 'restored'] &&
        request.resource.data.get('adminNote', '') is string &&
        request.resource.data.get('adminNote', '').size() <= 300 &&
        request.resource.data.get('moderatedAt', null) == request.time &&
        request.resource.data.get('moderatedBy', '') == request.auth.uid;
      allow delete: if false;
    }

    // التقييد مؤقت وبقرار إداري فقط؛ التقييم المنخفض وحده لا يفرضه تلقائيًا.
    match /customer_restrictions/{uid} {
      allow get: if signedIn() && (isAdmin() || request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isAdmin() && validCustomerRestriction(uid, request.resource.data);
      allow update: if isAdmin() && (
        validCustomerRestriction(uid, request.resource.data) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'clearedAt', 'clearedBy']) &&
          request.resource.data.get('active', true) == false &&
          request.resource.data.get('clearedAt', null) == request.time &&
          request.resource.data.get('clearedBy', '') == request.auth.uid)
      );
      allow delete: if false;
    }

    match /reviews/{rid} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin() ||
        (resource.data.get('storeId', '') != '' && isStoreOwner(resource.data.get('storeId', ''))));
      allow create: if signedIn() && (validCourierReview(rid, request.resource.data) ||
        validStoreReview(rid, request.resource.data));
      allow update, delete: if false;
    }

    // ───────────── طلبات الانضمام (مندوب / صاحب محل) ─────────────
    // معرّف المستند = uid + '_' + type، فالمستخدم عنده طلب واحد لكل نوع.
    // المستخدم ينشئ طلبه (pending) ويقدر يعيد التقديم لو اترفض. المدير بس هو اللي يقبل/يرفض.
    // الموافقة نفسها (كتابة couriers أو storeOwners) بيعملها المدير من التطبيق.
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function validStoreCategory(value) {
      return value in [
        'مطاعم', 'سوبرماركت', 'بقالة', 'خضار وفاكهة',
        'لحوم ودواجن', 'مخبوزات وحلويات', 'محمصات وعطارة',
        'كافيه ومشروبات', 'ورد وهدايا', 'أخرى'
      ];
    }

    function validRoleRequest(rid, d) {
      return d.keys().hasOnly(['userId', 'userEmail', 'type', 'name', 'phone', 'status',
                               'createdAt', 'storeName', 'storeCategory', 'address', 'vehicle', 'notes',
                               'storeImageUrl', 'registrationNumber', 'proofUrl', 'storePhone', 'storeId']) &&
        d.keys().hasAll(['userId', 'type', 'name', 'status', 'createdAt']) &&
        d.userId == request.auth.uid &&
        d.type in ['store_owner', 'courier'] &&
        rid == d.userId + '_' + d.type &&
        d.status == 'pending' &&
        d.createdAt == request.time &&
        d.get('userEmail', '') == request.auth.token.get('email', '') &&
        d.name is string && d.name.size() >= 2 && d.name.size() <= 80 &&
        optStr(d, 'phone', 11) &&
        optStr(d, 'storeId', 128) &&
        (d.get('phone', '') == '' || d.phone.matches('^01[0125][0-9]{8}$')) &&
        (d.type != 'courier' ||
          (d.get('phone', '') is string && d.phone.matches('^01[0125][0-9]{8}$'))) &&
        optStr(d, 'storeName', 100) && optStr(d, 'storeCategory', 60) &&
        optStr(d, 'address', 300) && optStr(d, 'vehicle', 60) &&
        optStr(d, 'notes', 500) && optStr(d, 'storeImageUrl', 450) &&
        optStr(d, 'registrationNumber', 30) && optStr(d, 'proofUrl', 450) &&
        optStr(d, 'storePhone', 20) &&
        (d.get('storePhone', '') == '' || d.storePhone.matches('^[0-9]{8,11}$')) &&
        (d.type != 'courier' || !('storeId' in d)) &&
        (d.type != 'store_owner' ||
          ('storeId' in d && d.storeId is string && d.storeId.size() > 0 &&
           existsAfter(/databases/$(database)/documents/stores/$(d.storeId)) &&
           getAfter(/databases/$(database)/documents/stores/$(d.storeId)).data.get('ownerUid', '') == d.userId &&
           getAfter(/databases/$(database)/documents/stores/$(d.storeId)).data.get('active', true) == false &&
           getAfter(/databases/$(database)/documents/stores/$(d.storeId)).data.get('approved', true) == false &&
           getAfter(/databases/$(database)/documents/stores/$(d.storeId)).data.get('name', '') == d.get('storeName', '') &&
           getAfter(/databases/$(database)/documents/stores/$(d.storeId)).data.get('category', '') == d.get('storeCategory', '') &&
           getAfter(/databases/$(database)/documents/stores/$(d.storeId)).data.get('address', '') == d.get('address', '') &&
           getAfter(/databases/$(database)/documents/stores/$(d.storeId)).data.get('imageUrl', '') == d.get('storeImageUrl', '') &&
           getAfter(/databases/$(database)/documents/stores/$(d.storeId)).data.get('storePhone', '') == d.get('storePhone', ''))) &&
        (d.type != 'store_owner' ||
          ('storeName' in d && d.storeName.size() >= 2 &&
           'storeCategory' in d && validStoreCategory(d.storeCategory) &&
           'address' in d && d.address.size() >= 5 &&
           'storeImageUrl' in d && d.storeImageUrl.matches('https://.*') &&
           (d.get('registrationNumber', '').size() >= 6 ||
            d.get('proofUrl', '').matches('https://.*') ||
            d.get('storePhone', '').matches('^[0-9]{8,11}$'))) &&
        (d.type == 'store_owner'
          ? (!exists(/databases/$(database)/documents/role_requests/$(d.userId + '_courier')) ||
             get(/databases/$(database)/documents/role_requests/$(d.userId + '_courier')).data.status != 'pending')
          : (!exists(/databases/$(database)/documents/role_requests/$(d.userId + '_store_owner')) ||
             get(/databases/$(database)/documents/role_requests/$(d.userId + '_store_owner')).data.status != 'pending')) &&
        (d.type != 'courier' || ('vehicle' in d && d.vehicle.size() >= 2));
    }

    match /role_requests/{rid} {
      allow get: if signedIn() && (isAdmin() || rid.matches(request.auth.uid + '_.*'));
      allow list: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn() && validRoleRequest(rid, request.resource.data);
      allow update: if
        (isAdmin() &&
          changedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'adminNote']) &&
          request.resource.data.status in ['approved', 'rejected'] &&
          request.resource.data.reviewedAt == request.time &&
          request.resource.data.reviewedBy == request.auth.uid &&
          request.resource.data.get('adminNote', '') is string &&
          request.resource.data.get('adminNote', '').size() <= 300 &&
          (request.resource.data.status != 'rejected' || request.resource.data.get('adminNote', '').size() >= 5)) ||
        // إعادة التقديم بعد الرفض فقط (بيستبدل المستند كله بطلب pending جديد).
        (signedIn() && resource.data.userId == request.auth.uid &&
          resource.data.status == 'rejected' &&
          validRoleRequest(rid, request.resource.data));
      allow delete: if false;
    }

    // ───────────── الشكاوى والاقتراحات ─────────────
    // أي مستخدم مسجّل (عميل أو مندوب أو صاحب محل) يبعت، ويقرأ بتاعته بس. المدير يقرأ الكل ويرد/يقفل.
    // نوع order_issue لازم يشاور على طلب بتاع نفس المستخدم.
    function validComplaint(d) {
      return d.keys().hasOnly(['userId', 'userEmail', 'userName', 'kind', 'message',
                               'orderId', 'appRole', 'status', 'createdAt']) &&
        d.keys().hasAll(['userId', 'kind', 'message', 'status', 'createdAt']) &&
        d.userId == request.auth.uid &&
        d.kind in ['complaint', 'suggestion', 'order_issue', 'restriction_appeal'] &&
        d.status == 'open' &&
        d.createdAt == request.time &&
        d.message is string && d.message.size() >= 5 && d.message.size() <= 1000 &&
        d.get('userEmail', '') == request.auth.token.get('email', '') &&
        optStr(d, 'userName', 80) && optStr(d, 'appRole', 20) &&
        optStr(d, 'orderId', 60) &&
        (d.kind != 'order_issue' || (
          'orderId' in d && d.orderId.size() > 0 &&
          get(/databases/$(database)/documents/orders/$(d.orderId)).data.userId == request.auth.uid)) &&
        (d.kind != 'restriction_appeal' || (
          'orderId' in d && d.orderId.size() > 0 &&
          exists(/databases/$(database)/documents/customer_restrictions/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/customer_restrictions/$(request.auth.uid)).data.get('sourceOrderId', '') == d.orderId));
    }

    match /complaints/{cid} {
      allow create: if signedIn() && validComplaint(request.resource.data);
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow update: if isAdmin() &&
        changedKeys().hasOnly(['status', 'adminNote', 'resolvedAt']) &&
        request.resource.data.status in ['open', 'in_progress', 'resolved'] &&
        request.resource.data.get('adminNote', '') is string &&
        request.resource.data.get('adminNote', '').size() <= 500;
      allow delete: if false;
    }

    // أصحاب المحلات: كل صاحب محل يقرأ مستنده هو، والمدير يقرأ الكل ويضيف ويعدّل ويوقف.
    // الشكل: { name, storeId, active }. صاحب المحل مايقدرش يكتب هنا أبدًا.
    match /storeOwners/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['name', 'storeId', 'active', 'phone']) &&
        request.resource.data.keys().hasAll(['name', 'storeId']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 80 &&
        request.resource.data.storeId is string && request.resource.data.storeId.size() > 0 &&
        request.resource.data.get('active', true) is bool;
      // صاحب المحل يقدر يحذف ربط حسابه فقط مع حذف محله في نفس الـ batch.
      allow delete: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         resource.data.get('storeId', '') is string &&
         isStoreOwner(resource.data.get('storeId', '')));
    }

    // طلبات المنتجات غير الموجودة: العميل ينشئ طلبًا لمحـل نشط،
    // وصاحب المحل المعني فقط (أو الإدارة) يقرأ الطلبات.
    match /special_requests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'storeId', 'storeName', 'userId', 'description', 'quantity',
          'imageUrl', 'voiceBase64', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'storeId', 'storeName', 'userId', 'description', 'quantity',
          'imageUrl', 'voiceBase64', 'status', 'createdAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.storeId is string &&
        request.resource.data.storeId.size() > 0 &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.get('active', true) == true &&
        request.resource.data.storeName is string &&
        request.resource.data.storeName.size() <= 100 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 300 &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity >= 1 && request.resource.data.quantity <= 99 &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imageUrl.size() <= 500 &&
        request.resource.data.voiceBase64 is string &&
        request.resource.data.voiceBase64.size() <= 700000 &&
        (request.resource.data.description.size() > 0 ||
         request.resource.data.imageUrl.size() > 0 ||
         request.resource.data.voiceBase64.size() > 0) &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time;
      allow read: if isAdmin() ||
        (signedIn() && isStoreOwner(resource.data.get('storeId', '')));
      allow update, delete: if false;
    }

    // المناديب: المدير يقرأ الكل (عشان التعيين)، والمندوب يقرأ مستنده هو.
    // الإضافة والتعديل من الـ Console فقط.
    match /couriers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      // المدير بيضيف المناديب ويعدّلهم ويوقفهم من التطبيق.
      allow create, update, delete: if isAdmin();
      // المشرف يشوف المناديب المربوطين بيه ويوقفهم/يفعّلهم بس.
      allow list: if isSupervisor() && resource.data.get('supervisorId', '') == request.auth.uid;
      allow update: if isSupervisor() &&
        resource.data.get('supervisorId', '') == request.auth.uid &&
        changedKeys().hasOnly(['active']) && request.resource.data.active is bool;
      // العميل يقدر يحدّث إحصائية التقييم فقط، ومع تقييم جديد في نفس الـ batch
      // (!exists = التقييم لسه ما اتكتبش قبل كده، عشان ما يتكررش احتسابه).
      allow update: if signedIn() &&
        changedKeys().hasOnly(['ratingSum', 'ratingCount', 'lastReviewId']) &&
        request.resource.data.lastReviewId is string &&
        !exists(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)) &&
        existsAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)) &&
        getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)).data.courierId == uid &&
        request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1 &&
        request.resource.data.ratingSum ==
          resource.data.get('ratingSum', 0) +
          getAfter(/databases/$(database)/documents/reviews/$(request.resource.data.lastReviewId)).data.rating;
    }

    // المشرفين: المدير يضيفهم ويعدّلهم، والمشرف يقرأ مستنده هو.
    match /supervisors/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['name', 'phone', 'active']);
      allow delete: if isAdmin();
    }

    // تسوية عمولات المناديب: كل إيصال مرتبط بتحديث ذري لرصيد المندوب.
    // يمنع التطبيق من تسجيل توريد منفصل عن دفتر الرصيد، ويحتفظ بهوية المدير المنفذ.
    match /courier_settlements/{sid} {
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'courierId', 'courierName', 'amount', 'amountMinor', 'note', 'createdBy', 'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'courierId', 'courierName', 'amount', 'amountMinor', 'note', 'createdBy', 'createdAt'
        ]) &&
        request.resource.data.courierId is string &&
        request.resource.data.courierId.size() > 0 &&
        request.resource.data.courierName is string &&
        request.resource.data.courierName.size() <= 80 &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 && request.resource.data.amount <= 1000000 &&
        request.resource.data.amountMinor is int &&
        request.resource.data.amountMinor > 0 && request.resource.data.amountMinor <= 100000000 &&
        request.resource.data.amountMinor >= request.resource.data.amount * 100 - 0.0001 &&
        request.resource.data.amountMinor <= request.resource.data.amount * 100 + 0.0001 &&
        request.resource.data.get('note', '') is string &&
        request.resource.data.get('note', '').size() <= 200 &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/courier_settlement_balances/$(request.resource.data.courierId)) &&
        getAfter(/databases/$(database)/documents/courier_settlement_balances/$(request.resource.data.courierId)).data.get('courierId', '') == request.resource.data.courierId &&
        getAfter(/databases/$(database)/documents/courier_settlement_balances/$(request.resource.data.courierId)).data.get('lastSettlementId', '') == sid &&
        getAfter(/databases/$(database)/documents/courier_settlement_balances/$(request.resource.data.courierId)).data.get('settledAmountMinor', 0) is int &&
        getAfter(/databases/$(database)/documents/courier_settlement_balances/$(request.resource.data.courierId)).data.get('settledAmountMinor', 0) >= request.resource.data.amountMinor;
      allow read: if signedIn() && (isAdmin() ||
        (isCourier() && resource.data.courierId == request.auth.uid));
      allow update, delete: if false;
    }

    match /courier_settlement_balances/{courierId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'courierId', 'settledAmountMinor', 'lastSettlementId', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'courierId', 'settledAmountMinor', 'lastSettlementId', 'updatedAt'
        ]) &&
        request.resource.data.courierId == courierId &&
        request.resource.data.settledAmountMinor is int &&
        request.resource.data.settledAmountMinor > 0 &&
        request.resource.data.lastSettlementId is string &&
        request.resource.data.lastSettlementId.size() > 0 &&
        request.resource.data.updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)) &&
        getAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)).data.get('courierId', '') == courierId &&
        getAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)).data.get('createdBy', '') == request.auth.uid &&
        getAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)).data.get('createdAt', null) == request.time &&
        getAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)).data.get('amountMinor', 0) <= request.resource.data.settledAmountMinor;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'settledAmountMinor', 'lastSettlementId', 'updatedAt'
        ]) &&
        request.resource.data.courierId == courierId &&
        request.resource.data.settledAmountMinor is int &&
        request.resource.data.settledAmountMinor > resource.data.get('settledAmountMinor', 0) &&
        request.resource.data.lastSettlementId is string &&
        request.resource.data.lastSettlementId.size() > 0 &&
        request.resource.data.updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)) &&
        getAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)).data.get('courierId', '') == courierId &&
        getAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)).data.get('createdBy', '') == request.auth.uid &&
        getAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)).data.get('createdAt', null) == request.time &&
        request.resource.data.settledAmountMinor - resource.data.get('settledAmountMinor', 0) ==
          getAfter(/databases/$(database)/documents/courier_settlements/$(request.resource.data.lastSettlementId)).data.get('amountMinor', 0);
      allow delete: if false;
    }

    // كوبونات الخصم: العميل يقرأ كود واحد بالاسم، والمدير يدير الكل.
    match /promos/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['percent', 'active', 'note', 'updatedAt']) &&
        request.resource.data.percent is number &&
        request.resource.data.percent > 0 && request.resource.data.percent <= 50 &&
        request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // المدير يقدر يقرا كل تقديمات المناديب مرة واحدة (collection group) في تبويب "تقديمات المناديب".
    match /{path=**}/applicants/{cid} {
      allow list: if isAdmin();
    }

    // ───────────── شات مباشر مع الإدارة ─────────────
    // support_chats/{uid}: محادثة واحدة لكل مستخدم (العميل/المندوب/صاحب المحل) مع الإدارة.
    // الشكل: { userId, userName, userEmail, appRole, lastMessage, lastSender ('user'|'admin'),
    //          lastAt, unreadForAdmin, unreadForUser }.
    // الرسائل في support_chats/{uid}/messages: { senderId, senderRole, text, createdAt }.
    // الرسالة بتتكتب مع تحديث مستند المحادثة في نفس الـ batch.
    match /support_chats/{uid} {
      function chatTextOk(t) {
        return t is string && t.size() <= 200;
      }

      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['userId', 'userName', 'userEmail', 'appRole',
          'lastMessage', 'lastSender', 'lastAt', 'unreadForAdmin', 'unreadForUser']) &&
        request.resource.data.keys().hasAll(['userId', 'lastMessage', 'lastSender', 'lastAt',
          'unreadForAdmin', 'unreadForUser']) &&
        request.resource.data.userId == uid &&
        request.resource.data.lastSender == 'user' &&
        request.resource.data.lastAt == request.time &&
        request.resource.data.unreadForAdmin == true &&
        request.resource.data.unreadForUser == false &&
        chatTextOk(request.resource.data.lastMessage) &&
        request.resource.data.get('userEmail', '') == request.auth.token.get('email', '') &&
        optStr(request.resource.data, 'userName', 80) &&
        optStr(request.resource.data, 'appRole', 20);

      allow update: if signedIn() && (
        // صاحب المحادثة بيبعت رسالة
        (request.auth.uid == uid &&
          changedKeys().hasOnly(['userName', 'userEmail', 'appRole', 'lastMessage', 'lastSender',
            'lastAt', 'unreadForAdmin', 'unreadForUser']) &&
          request.resource.data.lastSender == 'user' &&
          request.resource.data.lastAt == request.time &&
          request.resource.data.unreadForAdmin == true &&
          request.resource.data.unreadForUser == false &&
          chatTextOk(request.resource.data.lastMessage) &&
          request.resource.data.get('userEmail', '') == request.auth.token.get('email', '') &&
          optStr(request.resource.data, 'userName', 80) &&
          optStr(request.resource.data, 'appRole', 20)) ||
        // صاحب المحادثة فتحها (قرأ ردّ الإدارة)
        (request.auth.uid == uid &&
          changedKeys().hasOnly(['unreadForUser']) &&
          request.resource.data.unreadForUser == false) ||
        // المدير بيرد
        (isAdmin() &&
          changedKeys().hasOnly(['lastMessage', 'lastSender', 'lastAt', 'unreadForUser',
            'unreadForAdmin']) &&
          request.resource.data.lastSender == 'admin' &&
          request.resource.data.lastAt == request.time &&
          request.resource.data.unreadForUser == true &&
          request.resource.data.unreadForAdmin == false &&
          chatTextOk(request.resource.data.lastMessage)) ||
        // المدير فتح المحادثة
        (isAdmin() &&
          changedKeys().hasOnly(['unreadForAdmin']) &&
          request.resource.data.unreadForAdmin == false));

      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt']) &&
          request.resource.data.keys().hasAll(['senderId', 'senderRole', 'text', 'createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000 &&
          request.resource.data.createdAt == request.time &&
          ((request.resource.data.senderRole == 'user' && request.auth.uid == uid) ||
           (request.resource.data.senderRole == 'admin' && isAdmin()));
        allow update, delete: if false;
      }
    }
  }
}
